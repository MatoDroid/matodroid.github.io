#!/data/data/com.termux/files/usr/bin/bash
# Spusta sa, ked v appke YouTube dáte Zdielat -> Termux.
# Stiahne prepis cez yt-dlp, ulozi ho ako .txt a ponukne zdielanie (napr. do Claude).

URL="$1"
LANGS="${YTPREPIS_LANGS:-sk,cs,en}"        # poradie preferovanych jazykov
OUT="${YTPREPIS_DIR:-$HOME/storage/downloads/YT-prepisy}"
BIN="$(dirname "$(readlink -f "$0")")"

say() { echo "$*"; command -v termux-toast >/dev/null && termux-toast -s "$*"; }

[ -d "$HOME/storage" ] || { echo "Najprv spustite: termux-setup-storage"; sleep 5; exit 1; }
mkdir -p "$OUT"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Z textu zdielania vytiahneme len odkaz.
URL="$(printf '%s' "$URL" | grep -oE 'https?://[^ ]+' | head -n1)"
[ -n "$URL" ] || { say "V zdielanom texte nie je odkaz."; sleep 3; exit 1; }

# JS runtime pre YouTube (EJS); Deno je predvoleny, na Termuxe pouzivame Node.
JSRT=""
command -v node >/dev/null && JSRT="--js-runtimes node"

YT() { yt-dlp $JSRT --no-playlist --sleep-requests 1 "$@"; }

# 1) Jedna extrakcia: nazov a zoznam dostupnych titulkov.
echo "Zistujem dostupne titulky: $URL"
if ! YT --skip-download -J "$URL" > "$TMP/info.json" 2> "$TMP/err.log"; then
  cat "$TMP/err.log"
  echo "Skusam aktualizovat yt-dlp a zopakovat..."
  pip install -q -U yt-dlp yt-dlp-ejs
  YT --skip-download -J "$URL" > "$TMP/info.json" 2> "$TMP/err.log" || { cat "$TMP/err.log"; say "yt-dlp zlyhal, pozri vypis."; sleep 6; exit 1; }
fi

# 2) Vyber JEDNEHO jazyka (menej poziadaviek = mensia sanca na HTTP 429).
#    Poradie: rucne titulky v preferovanom jazyku, potom povodne automaticke,
#    potom hocijake rucne.
python - "$LANGS" "$TMP/info.json" "$TMP/pick.txt" <<'PY'
import json, re, sys, unicodedata
prefs = [p.strip() for p in sys.argv[1].split(",") if p.strip()]
d = json.load(open(sys.argv[2], encoding="utf-8"))
man = list((d.get("subtitles") or {}).keys())
auto = list((d.get("automatic_captions") or {}).keys())
orig = [k for k in auto if k.endswith("-orig")]

def base(k): return k.split("-")[0].lower()

pick = ""
for p in prefs:                                   # rucne v preferovanom jazyku
    m = [k for k in man if k == p] or [k for k in man if base(k) == p]
    if m: pick = m[0]; break
if not pick:
    for p in prefs:                               # povodne automaticke
        m = [k for k in orig if base(k) == p]
        if m: pick = m[0]; break
if not pick:
    for p in prefs:                               # automaticke v danom jazyku
        m = [k for k in auto if k == p]
        if m: pick = m[0]; break
if not pick and man: pick = man[0]
if not pick and orig: pick = orig[0]
title = (d.get("title") or "").replace("\n", " ")
vid = d.get("id") or ""
# Nazov suboru: ASCII (bez diakritiky), medzery a znaky ako _, max 80 znakov.
safe = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
safe = re.sub(r"[^A-Za-z0-9]+", "_", safe).strip("_")[:80].strip("_")
if not safe:
    safe = "yt_" + vid
open(sys.argv[3], "w", encoding="utf-8").write("\n".join([pick, title, vid, safe]) + "\n")
PY
LANG_PICK="$(sed -n 1p "$TMP/pick.txt")"
TITLE="$(sed -n 2p "$TMP/pick.txt")"
VIDEO_ID="$(sed -n 3p "$TMP/pick.txt")"
SAFE="$(sed -n 4p "$TMP/pick.txt")"
[ -n "$LANG_PICK" ] || { say "Video nema ziadne titulky."; sleep 4; exit 1; }
echo "Jazyk titulkov: $LANG_PICK"

# 3) Stiahnutie titulkov; pri HTTP 429 pocka a skusi znova.
VTT=""
for try in 1 2 3; do
  YT --skip-download --write-subs --write-auto-subs --sub-langs "$LANG_PICK" \
     --sub-format vtt --sleep-subtitles 2 -o "$TMP/v.%(ext)s" "$URL" 2>&1 | tee "$TMP/dl.log"
  VTT="$(ls "$TMP"/v.*.vtt 2>/dev/null | head -n1)"
  [ -n "$VTT" ] && break
  grep -q "429" "$TMP/dl.log" || break          # ina chyba nez limit - nema zmysel opakovat
  [ "$try" -lt 3 ] && { say "YouTube obmedzil pocet poziadaviek (429), skusam znova o $((20 * try)) s..."; sleep $((20 * try)); }
done

if [ -z "$VTT" ]; then
  if grep -q "429" "$TMP/dl.log"; then
    say "YouTube docasne blokuje stahovanie (429). Skuste o niekolko minut."
  else
    say "Titulky sa nepodarilo stiahnut, pozri vypis."
  fi
  sleep 6; exit 1
fi

[ -n "$TITLE" ] || TITLE="prepis-$(date +%F-%H%M%S)"
FILE="$OUT/${SAFE}_${VIDEO_ID}.txt"

if ! { printf '%s\n%s\n\n' "$TITLE" "$URL"; python "$BIN/vtt2txt.py" "$VTT"; } > "$FILE" || [ ! -s "$FILE" ]; then
  say "Subor sa nepodarilo ulozit: $FILE"
  sleep 6; exit 1
fi

say "Ulozene: $FILE"
command -v termux-share >/dev/null && termux-share -a send -c text/plain "$FILE"
